  {
   "id": "s1",
   "source_id": "fs-idm165750544",
   "kind": "simulation-exercise",
   "bloom": "Apply",
   "place": {
    "at": "end"
   },
   "cite": "displacement",
   "prompt": "使用例 1.2 上方的排水图。选择未知材料，并将方块的体积设为 5.7 mL。（a）用排水法测量未知材料的质量和体积。（b）用步骤（a）中测得的质量和体积数据计算未知材料的密度。（c）假设这种材料是一种常见的含铜宝石，它很可能是什么？把测得的密度与宝石密度指南中列出的值作比较。（d）体积相同的方块，其质量与密度有什么关系？",
   "answer": {
    "type": "multi",
    "generated_by": "source",
    "parts": [
     {
      "part": "(a) mass",
      "value": 18.58,
      "unit": "g",
      "hint": "读出放上未知方块时天平的读数。"
     },
     {
      "part": "(a) volume",
      "value": 5.7,
      "unit": "mL",
      "hint": "体积是方块位于水面之下时水位的上升量。"
     },
     {
      "part": "(b) density",
      "value": 3.3,
      "unit": "g/mL",
      "hint": "用质量除以体积。"
     }
    ],
    "solution": "（a）m = 18.58 g，V = 5.7 mL；（b）d = 3.3 g/mL；（c）孔雀石（碱式碳酸铜，d = 3.25—4.10 g/mL）；（d）密度与质量成正比，与体积成反比。因此体积相同的方块，其密度与质量之间呈正比关系。"
   }
  }
 ],
