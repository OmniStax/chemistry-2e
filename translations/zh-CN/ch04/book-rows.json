    {
     "id": "eq-percent-yield",
     "latex": "\\text{percent yield}=\\left(\\frac{\\text{actual yield}}{\\text{theoretical yield}}\\right)\\times 100\\%",
     "anchor": "4.4-percent-yield"
    }
   ]
  },
  {
   "id": "atom-economy",
   "kind": "definition",
   "section": "4.4",
   "name": "原子经济性",
   "statement": "一个过程的原子经济性，是所需产物的质量占所用全部反应物质量的百分数，它度量投入的物质中有多少最终进入了产物。它看上去与产率相似，但比较的是不同过程的理论效率，而产率比较的是某一过程实际得到的量与它可能得到的量。",
   "forms": [
    {
     "id": "eq-atom-economy",
     "latex": "\\text{atom economy}=\\frac{\\text{mass of product}}{\\text{mass of reactants}}\\times 100\\%",
     "condition": "the theoretical efficiency of a synthesis, the mass of the desired product as a percentage of the mass of all the reactants used",
     "anchor": "4.4-atom-economy"
    }
   ]
  },
  {
   "id": "theoretical-yield",
   "kind": "definition",
   "section": "4.4",
   "name": "理论产量",
   "terms": [
    "理论产量"
   ],
   "statement": "理论产量是按反应的化学计量，由给定量的反应物所能生成的产物的量。"
  },
  {
   "id": "actual-yield",
   "kind": "definition",
   "section": "4.4",
   "name": "实际产量",
   "terms": [
    "实际产量"
   ],
   "statement": "实际产量是反应中实际生成的产物的量。"
  },
  {
   "id": "excess-reactant",
   "kind": "definition",
   "section": "4.4",
   "name": "过量反应物",
   "terms": [
    "过量反应物"
   ],
   "statement": "过量反应物是其存在量大于反应的化学计量所需量的反应物。"
  },
  {
   "id": "quantitative-analysis",
   "kind": "definition",
   "section": "4.5",
   "name": "化学定量分析",
   "terms": [
    "定量分析"
   ],
   "statement": "定量分析是测定样品中某种物质的量或浓度，反应化学计量是它的基础之一：与待测物化合的反应物的量，或待测物所生成的产物的量，度量了原来有多少待测物。"
  },
  {
   "id": "titration",
   "kind": "idea",
   "section": "4.5",
   "name": "滴定分析",
   "terms": [
    "滴定分析"
   ],
   "statement": "在滴定中，用滴定管把已知浓度的滴定剂加到待测物样品中，直到两者之间的反应完成。到达这一化学计量点所需的滴定剂体积，通过指示剂颜色变化等现象检测出来，成为滴定终点，再借助反应的化学计量度量出待测物的量。"
  },
  {
   "id": "titration-calculation",
   "kind": "skill",
   "section": "4.5",
   "name": "由滴定数据计算浓度",
   "statement": "滴定剂的体积和物质的量浓度给出它的物质的量，化学计量因子给出待测物的物质的量，再除以样品体积就得到待测物的物质的量浓度。因为物质的量浓度也等于每毫升中的毫摩尔数，所以整个计算可以始终用毫升进行。"
  },
  {
   "id": "gravimetric-analysis",
   "kind": "skill",
   "section": "4.5",
   "name": "重量分析法",
   "terms": [
    "重量分析法"
   ],
   "statement": "在重量分析法中，通过状态的变化（常常是沉淀和过滤）把待测物从样品中分离出来并称量；把分离所得物质的质量代入化学计量，就得到待测物的质量及其占样品的百分数。"
  },
  {
   "id": "combustion-analysis",
   "kind": "skill",
   "section": "4.5",
   "name": "燃烧分析",
   "terms": [
    "燃烧分析"
   ],
   "statement": "把称量过的碳氢化合物样品在氧气中完全燃烧，生成的二氧化碳和水分别收集在事先称量过的吸收器中。每种产物的质量给出样品中碳和氢的物质的量，它们的最简整数比就给出实验式。"
  },
  {
   "id": "analyte",
   "kind": "definition",
   "section": "4.5",
   "name": "待测物",
   "terms": [
    "待测物"
   ],
   "statement": "待测物是分析中所关注的化学物种。"
  },
  {
   "id": "titrant",
   "kind": "definition",
   "section": "4.5",
   "name": "滴定剂",
   "terms": [
    "滴定剂"
   ],
   "statement": "滴定剂是滴定分析中含有已知浓度的、将与待测物反应的物质的溶液。"
  },
  {
   "id": "buret",
   "kind": "definition",
   "section": "4.5",
   "name": "滴定管",
   "terms": [
    "滴定管"
   ],
   "statement": "滴定管是用来精确放出可变体积液体的仪器，如用于滴定分析。"
  },
  {
   "id": "equivalence-point",
   "kind": "definition",
   "section": "4.5",
   "name": "化学计量点",
   "terms": [
    "化学计量点"
   ],
   "statement": "化学计量点是在滴定分析中与待测物完全反应所需的滴定剂溶液的体积，即相对于样品中的待测物恰好符合化学计量的滴定剂的量。"
  },
  {
   "id": "end-point",
   "kind": "definition",
   "section": "4.5",
   "name": "滴定终点",
   "terms": [
    "滴定终点"
   ],
   "statement": "滴定终点是所测得的滴定剂溶液的体积，在这一体积时样品的外观或其他性质出现与化学计量相当所预期的变化。"
  },
  {
   "id": "indicator",
   "kind": "definition",
   "section": "4.5",
   "name": "指示剂",
   "terms": [
    "指示剂"
   ],
   "statement": "指示剂是在滴定分析中加到样品里、用来目测滴定终点的物质。"
  }
 ],
