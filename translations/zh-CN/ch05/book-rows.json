 "concepts": [
  {
   "id": "energy-and-work",
   "kind": "definition",
   "section": "5.1",
   "name": "能量",
   "symbol": "E",
   "terms": [
    "能量"
   ],
   "type": "energy",
   "statement": "能量是供给热量或做功的能力。做功是能量所做的两类事情之一：使物质逆着相反的作用力运动，例如打气筒把空气压进轮胎时所做的功。"
  },
  {
   "id": "potential-and-kinetic-energy",
   "kind": "idea",
   "section": "5.1",
   "name": "势能与动能",
   "statement": "能量可以分为两类：势能，是物体因其位置、组成或状态而具有的能量；动能，是物体因其运动而具有的能量。汽油中储存的化学能是势能，热能则是动能。"
  },
  {
   "id": "conservation-of-energy",
   "kind": "axiom",
   "section": "5.1",
   "name": "能量守恒定律",
   "statement": "在化学变化或物理变化中，能量既不能被创造，也不能被消灭，但可以改变形式。因此，反应放出的热量必定出现在别的地方。"
  },
  {
   "id": "thermal-energy-and-temperature",
   "kind": "idea",
   "section": "5.1",
   "name": "热能与温度",
   "statement": "热能是原子和分子无规则运动的动能，温度则是衡量样品冷热程度的量，随粒子平均动能的增大而升高。二者并不相同：一堆篝火和一根火柴可以温度相同，所含的热能却相差悬殊。"
  },
  {
   "id": "heat-flow",
   "kind": "definition",
   "section": "5.1",
   "name": "热量",
   "symbol": "q",
   "terms": [
    "热量"
   ],
   "type": "energy",
   "statement": "热量是处于不同温度的两个物体之间热能的传递。它自发地从较热的物体流向较冷的物体，使前者的平均动能降低、后者的平均动能升高，直到二者达到热平衡、温度相同为止。"
  },
  {
   "id": "exothermic-and-endothermic",
   "kind": "definition",
   "section": "5.1",
   "name": "放热过程与吸热过程",
   "statement": "放出热量的化学反应或物理变化是放热的，吸收热量的则是吸热的。放热过程使环境变热，吸热过程使环境变冷。"
  },
  {
   "id": "energy-units",
   "kind": "skill",
   "section": "5.1",
   "name": "能量单位的换算",
   "statement": "能量的 SI 单位是焦耳，但化学家仍常使用卡，食品标签则以大卡为单位给出能量，每 1 大卡是 1 千卡。1 卡恰好等于 4.184 焦耳。能熟练地在这些单位之间换算，才能读懂食品标签，或比较以任一单位给出的结果。"
  },
  {
   "id": "heat-capacity-and-specific-heat",
   "kind": "definition",
   "section": "5.1",
   "name": "热容与比热容",
   "statement": "物体的热容是它的温度变化 1 °C 时所吸收或放出的热量，它随物质的多少而增大，因此是广度性质。比热容是使 1 g 某种物质的温度升高 1 °C 所需的热量，它只取决于物质的种类，因此是强度性质。"
  },
  {
   "id": "heat-specific-heat-relation",
   "kind": "result",
   "section": "5.1",
   "name": "热量与比热容",
   "statement": "物质吸收或放出的热量，等于它的比热容、质量与温度变化三者的乘积，温度变化取最终温度减去初始温度。q 的符号由这个差值决定：物质升温时为正，降温时为负；只要已知其中三个量，就能求出第四个。",
   "forms": [
    {
     "id": "eq-heat",
     "latex": "q=c\\times m\\times\\Delta T=c\\times m\\times(T_{\\text{final}}-T_{\\text{initial}})",
     "ktex": "\\kq=c\\times\\km\\times\\kdT=c\\times\\km\\times(\\kTfin-\\kTinit)",
     "condition": "不发生化学反应或相变，且在该温度范围内把比热容视为常数",
     "anchor": "5.1-heat-equation"
    }
   ]
  },
  {
   "id": "thermochemistry",
   "kind": "definition",
   "section": "5.1",
   "name": "热化学",
   "terms": [
    "热化学"
   ],
   "statement": "热化学是测量化学反应或物理变化中所吸收或放出的热量的科学。"
  },
  {
   "id": "work",
   "kind": "definition",
   "section": "5.1",
   "name": "功",
   "symbol": "w",
   "terms": [
    "功"
   ],
   "type": "energy",
   "statement": "功是使物质逆着相反的作用力运动，或改变压强、体积等外部宏观变量的能量传递。"
  },
  {
   "id": "potential-energy",
   "kind": "definition",
   "section": "5.1",
   "name": "势能",
   "terms": [
    "势能"
   ],
   "statement": "势能是粒子或粒子体系因其相对位置、组成或状态而具有的能量。"
  },
  {
   "id": "kinetic-energy",
   "kind": "definition",
   "section": "5.1",
   "name": "动能",
   "symbol": "KE",
   "terms": [
    "动能"
   ],
   "type": "energy",
   "statement": "动能是物体因其运动而具有的能量，等于其质量与速度平方之积的二分之一。",
   "forms": [
    {
     "id": "eq-kinetic-energy",
     "latex": "\\text{KE}=\\frac{1}{2}mu^2",
     "ktex": "\\kKE=\\frac{1}{2}\\km u^2",
     "condition": "质量为 m、以速率 u 运动的粒子",
     "section": "9.5",
     "anchor": "9.5-speeds"
    },
    {
     "id": "eq-kinetic-energy-2",
     "latex": "KE = \\frac{1}{2}mv^2"
    }
   ]
  },
  {
   "id": "thermal-energy",
   "kind": "definition",
   "section": "5.1",
   "name": "热能",
   "terms": [
    "热能"
   ],
   "statement": "热能是与原子和分子的无规则运动相联系的动能。"
  },
  {
   "id": "exothermic-process",
   "kind": "definition",
   "section": "5.1",
   "name": "放热过程",
   "terms": [
    "放热过程"
   ],
   "statement": "放热过程是放出热量的化学反应或物理变化。"
  },
  {
   "id": "endothermic-process",
   "kind": "definition",
   "section": "5.1",
   "name": "吸热过程",
   "terms": [
    "吸热过程"
   ],
   "statement": "吸热过程是吸收热量的化学反应或物理变化。"
  },
  {
   "id": "joule",
   "kind": "definition",
   "section": "5.1",
   "name": "焦耳",
   "terms": [
    "焦耳（J）"
   ],
   "statement": "焦耳是能量的 SI 单位，等于 1 N 的力使物体移动 1 m 所用的能量。",
   "forms": [
    {
     "id": "eq-joule",
     "latex": "1\\ \\text{J} = 1\\ \\text{kg m}^2/\\text{s}^2"
    }
   ]
  },
  {
   "id": "calorie",
   "kind": "definition",
   "section": "5.1",
   "name": "卡",
   "terms": [
    "卡（cal）"
   ],
   "statement": "卡是热量或其他能量的单位，是使 1 g 水的温度升高 1 °C 所需的能量。1 卡恰好等于 4.184 焦耳。",
   "forms": [
    {
     "id": "eq-calorie",
     "latex": "1\\ \\text{cal} = 4.184\\ \\text{J}"
    }
   ]
  },
  {
   "id": "heat-capacity",
   "kind": "definition",
   "section": "5.1",
   "name": "热容",
   "symbol": "C_heat",
   "terms": [
    "热容"
   ],
   "type": "heat-capacity",
   "statement": "一个物体的热容是使其温度升高 1 °C 所需的热量。它是广度性质，随物体中物质的多少而增大。",
   "forms": [
    {
     "id": "eq-heat-capacity",
     "latex": "C=\\frac{q}{\\Delta T}",
     "ktex": "C=\\frac{\\kq}{\\kdT}",
     "condition": "物体吸收或放出热量 q，且不发生化学反应或相变",
     "anchor": "5.1-capacity"
    }
   ]
  },
  {
   "id": "specific-heat-capacity",
   "kind": "definition",
   "section": "5.1",
   "name": "比热容",
   "symbol": "c_spec",
   "terms": [
    "比热容"
   ],
   "type": "heat-capacity",
   "statement": "物质的比热容是使 1 g 该物质的温度升高 1 °C 所需的热量。它是强度性质，仅取决于物质的种类。",
   "forms": [
    {
     "id": "eq-specific-heat",
     "latex": "c=\\frac{q}{m\\,\\Delta T}",
     "ktex": "c=\\frac{\\kq}{\\km\\,\\kdT}",
     "condition": "同一种物质的样品，不发生化学反应或相变",
     "anchor": "5.1-capacity"
    }
   ]
  },
  {
   "id": "system-and-surroundings",
   "kind": "definition",
   "section": "5.2",
   "name": "体系与环境",
   "statement": "体系是正在研究的化学变化或物理变化所涉及的那部分物质，环境则是其余的一切，它们向体系供给热量，或从体系带走热量。热量的符号是站在体系的立场上取定的。"
  },
  {
   "id": "calorimetry-heat-balance",
   "kind": "result",
   "section": "5.2",
   "name": "量热计中的热量平衡",
   "statement": "把热的金属放入理想量热计中的冷水时，一方失去的热量全部被另一方得到，所以两个热量之和为零，一个是另一个的负值。负号记录的是热量流动方向相反，并不能由它直接确定任何一个热量的符号。",
   "forms": [
    {
     "id": "eq-heat-balance",
     "latex": "q_{\\text{substance M}}+q_{\\text{substance W}}=0",
     "ktex": "\\kq_{\\text{substance M}}+\\kq_{\\text{substance W}}=0",
     "condition": "理想量热计，其中全部热传递都发生在这两种物质之间",
     "anchor": "5.2-heat-balance"
    }
   ]
  },
  {
   "id": "heat-of-reaction-by-calorimetry",
   "kind": "result",
   "section": "5.2",
   "name": "用量热法求反应热",
   "statement": "因为能量既不被创造也不被消灭，量热计中的反应所产生或消耗的热量，等于周围溶液所吸收或失去的热量，二者符号相反。这是所有量热问题的核心概念：测出溶液的温度变化，就能由此求出反应的热量。",
   "forms": [
    {
     "id": "eq-heat-reaction",
     "latex": "q_{\\text{reaction}}=-q_{\\text{solution}}",
     "ktex": "\\kq_{\\text{reaction}}=-\\kq_{\\text{solution}}",
     "condition": "量热计本身不吸收热量，也不与外界环境交换热量",
     "anchor": "5.2-reaction-heat"
    }
   ]
  },
  {
   "id": "coffee-cup-calorimetry",
   "kind": "skill",
   "section": "5.2",
   "name": "咖啡杯量热法",
   "statement": "咖啡杯量热计测得的是温度变化，要把它化为热量，需要作出合理的假设，并明确说明。假设没有热量传到外界或杯子中，并且稀溶液的比热容和密度与水相同。把这些假设贯彻到底，求出符号正确的热量。"
  },
  {
   "id": "bomb-calorimetry",
   "kind": "skill",
   "section": "5.2",
   "name": "弹式量热法",
   "statement": "弹式量热计在恒容条件下工作，用于燃烧这类放出大量热量并生成气体产物的反应。反应的热量由水和钢制弹体分担，所以计算时要把水吸收的热量，加上弹体的热容与温升之积。",
   "forms": [
    {
     "id": "eq-bomb",
     "latex": "q_{\\text{rxn}}=-(q_{\\text{water}}+q_{\\text{bomb}})",
     "ktex": "\\kq_{\\text{rxn}}=-(\\kq_{\\text{water}}+\\kq_{\\text{bomb}})",
     "condition": "弹式量热计，忽略产物和过量氧气所吸收的热量",
     "anchor": "5.2-ex-bomb"
    }
   ]
  },
  {
   "id": "food-calories",
   "kind": "skill",
   "section": "5.2",
   "name": "计算食物中的大卡数",
   "statement": "食品标签以大卡为单位给出能量。阿特沃特系统根据一份食物中蛋白质、碳水化合物和脂肪的克数，以及它们每克的平均大卡数来计算，这些数值来自弹式量热法。用这个求和，就可以核对标签，并比较不同的食物。"
  },
  {
