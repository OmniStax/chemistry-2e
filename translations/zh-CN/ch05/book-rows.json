  },
  {
   "id": "nutritional-calorie",
   "kind": "definition",
   "section": "5.2",
   "name": "大卡",
   "terms": [
    "大卡（Cal）"
   ],
   "statement": "大卡是营养学中表示食物消化所提供能量的单位，定义为 1000 卡，即 1 千卡。",
   "forms": [
    {
     "id": "eq-nutritional-calorie",
     "latex": "1\\ \\text{Cal} = 1\\ \\text{kcal}"
    }
   ]
  },
  {
   "id": "first-law-of-thermodynamics",
   "kind": "axiom",
   "section": "5.3",
   "name": "热力学第一定律",
   "terms": [
    "热力学第一定律"
   ],
   "statement": "体系的内能只因热量流入或流出体系，以及对体系做功或体系做功而改变。符号取体系一侧：热量流入时 q 为正，对体系做功时 w 为正。因此，既放出热量又做功的体系，内能在两方面都减少，发动机气缸中的气体就是这样。",
   "forms": [
    {
     "id": "eq-first-law",
     "latex": "\\Delta U=q+w",
     "ktex": "\\kdU=\\kq+\\kwork",
     "anchor": "5.3-first-law"
    }
   ]
  },
  {
   "id": "state-function",
   "kind": "definition",
   "section": "5.3",
   "name": "状态函数",
   "terms": [
    "状态函数"
   ],
   "statement": "状态函数的值只取决于体系所处的状态，而与该状态是如何达到的无关。内能和焓是状态函数，热量和功则不是，就像山顶的海拔与攀登的路线无关，而走过的路程却与路线有关。盖斯定律就建立在这一性质上。"
  },
  {
   "id": "enthalpy-change-at-constant-pressure",
   "kind": "result",
   "section": "5.3",
   "name": "恒压下的焓变",
   "type": "energy",
   "statement": "焓是体系的内能与其压强和体积之积的和。对于恒压且只做膨胀功的过程，焓变等于热量流动，所以通常在大气的恒定压强下工作的化学家用焓来描述反应的热量。在恒容的弹式量热计中测得的热量不是 ΔH。",
   "forms": [
    {
     "id": "eq-dh-qp",
     "latex": "\\Delta H=q_{\\text{p}}",
     "ktex": "\\kdH=\\kqp",
     "condition": "恒压过程，且所做的功仅由膨胀或收缩引起",
     "anchor": "5.3-enthalpy"
    }
   ]
  },
  {
   "id": "thermochemical-equations",
   "kind": "skill",
   "section": "5.3",
   "name": "热化学方程式的书写与换算",
   "statement": "热化学方程式在配平的方程式之后给出 ΔH，对应于方程式所示的以摩尔计的物质的量。由于 ΔH 是广度性质，它随系数按比例变化；把方程式反过来写，它的符号改变；它还取决于所写的物态。要把这三条规则都用上，并且在把测得的热量化为 ΔH 时考虑限量反应物。"
  },
  {
   "id": "enthalpy-of-combustion",
   "kind": "skill",
   "section": "5.3",
   "name": "使用标准燃烧焓",
   "statement": "标准燃烧焓是 1 mol 物质在标准状态条件下完全燃烧时的焓变。有了它，再借助前几章的换算，就能求出任意量的燃料放出的热量，例如由异辛烷的值可以得出 1.00 L 汽油放出的热量。"
  },
  {
   "id": "standard-enthalpy-of-formation",
   "kind": "definition",
   "section": "5.3",
   "name": "标准生成焓",
   "symbol": "ΔH_f°",
   "terms": [
    "标准生成焓"
   ],
   "type": "energy",
   "statement": "标准状态是一组约定的参考条件，即 1 bar 和 1 M，并默认温度为 298.15 K，ΔH° 表示这些条件下的焓变。标准生成焓是由处于最稳定状态的单质生成恰好 1 mol 某物质的 ΔH°，所以处于最稳定形式的单质，其值为零，而生成反应的方程式常带有分数系数。"
  },
  {
   "id": "hess-law",
   "kind": "result",
   "section": "5.3",
   "name": "盖斯定律",
   "terms": [
    "盖斯定律"
   ],
   "statement": "如果一个过程是几个分步过程之和，则总过程的焓变等于各步焓变之和。这样，对于难以进行或有危险的反应，就可以把已知焓变的反应按需要反过来写或按比例换算后相加，求出其焓变。"
  },
  {
   "id": "enthalpy-from-formation-enthalpies",
   "kind": "skill",
   "section": "5.3",
   "name": "由生成焓求反应焓变",
   "statement": "应用盖斯定律：把反应物分解为各自的单质，再重新生成产物。任一反应的标准焓变就等于各产物的生成焓乘以 n 之和，减去反应物的同样之和。借助附录 G 的表，可以计算没有人直接测量过的反应的 ΔH°。",
   "forms": [
    {
     "id": "eq-hess-formation",
     "latex": "\\Delta H_{\\text{reaction}}^{\\circ}=\\sum n\\times\\Delta H_{\\text{f}}^{\\circ}(\\text{products})-\\sum n\\times\\Delta H_{\\text{f}}^{\\circ}(\\text{reactants})",
     "ktex": "\\kdHo_{\\text{reaction}}=\\sum n\\times\\kdHf(\\text{products})-\\sum n\\times\\kdHf(\\text{reactants})",
     "condition": "标准状态条件，n 为配平的方程式中的化学计量系数",
     "anchor": "5.3-formation-enthalpies"
    }
   ]
  },
  {
   "id": "chemical-thermodynamics",
   "kind": "definition",
   "section": "5.3",
   "name": "化学热力学",
   "terms": [
    "化学热力学"
   ],
   "statement": "化学热力学是研究与化学过程和物理过程相关的热量、功及各种形式能量之间关系的科学领域。"
  },
  {
   "id": "internal-energy",
   "kind": "definition",
   "section": "5.3",
   "name": "内能",
   "symbol": "U",
   "terms": [
    "内能"
   ],
   "type": "energy",
   "statement": "体系的内能是其所含物质中存在的所有可能形式的能量的总和。"
  },
  {
   "id": "expansion-work",
   "kind": "definition",
   "section": "5.3",
   "name": "膨胀功",
   "terms": [
    "膨胀功（压强–体积功）"
   ],
   "statement": "膨胀功，或称压强–体积功，是体系抵抗外压膨胀或收缩时所做的功。",
   "forms": [
    {
     "id": "eq-expansion-work",
     "latex": "P\\Delta V=-w",
     "ktex": "\\kP\\kdV=-\\kwork",
     "condition": "膨胀功或压强–体积功",
     "anchor": "5.3-enthalpy"
    }
   ]
  },
  {
   "id": "enthalpy",
   "kind": "definition",
   "section": "5.3",
   "name": "焓",
   "symbol": "H",
   "terms": [
    "焓"
   ],
   "type": "energy",
   "statement": "体系的焓是其内能与压强和体积之积的和。",
   "forms": [
    {
     "id": "eq-enthalpy",
     "latex": "H=U+PV",
     "ktex": "\\kH=\\kU+\\kP\\kV",
     "anchor": "5.3-enthalpy"
    }
   ]
  },
  {
   "id": "enthalpy-change",
   "kind": "definition",
   "section": "5.3",
   "name": "焓变",
   "symbol": "ΔH",
   "terms": [
    "焓变"
   ],
   "type": "energy",
   "statement": "一个过程的焓变是体系焓的变化，当过程在恒压下进行时，它等于体系放出或吸收的热量。",
   "forms": [
    {
     "id": "eq-enthalpy-change",
     "latex": "\\Delta H=\\Delta U+P\\Delta V",
     "ktex": "\\kdH=\\kdU+\\kP\\kdV",
     "condition": "恒压过程",
     "anchor": "5.3-enthalpy"
    }
   ]
  },
  {
   "id": "standard-state",
   "kind": "definition",
   "section": "5.3",
   "name": "标准状态",
   "terms": [
    "标准状态"
   ],
   "statement": "标准状态是被公认为报告热力学性质的共同参考条件的一组物理条件：压强 1 bar、浓度 1 M，并默认温度为 298.15 K。焓变符号上的度符号（°）表示该过程在这些条件下进行。"
  },
  {
   "id": "hydrocarbon",
   "kind": "definition",
   "section": "5.3",
   "name": "烃",
   "terms": [
    "烃"
   ],
   "statement": "烃是只由氢和碳组成的化合物，是化石燃料的主要成分。"
  },
  {
   "id": "standard-enthalpy-of-combustion",
   "kind": "definition",
   "section": "5.3",
   "name": "标准燃烧焓",
   "symbol": "ΔH_c°",
   "terms": [
    "标准燃烧焓"
   ],
   "type": "energy",
   "statement": "物质的标准燃烧焓是 1 mol 该物质在标准状态条件下完全燃烧时的焓变。"
  }
