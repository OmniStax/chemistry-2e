 "concepts": [
  {
   "id": "photon-energy",
   "kind": "axiom",
   "section": "6.1",
   "name": "光子能量",
   "statement": "光以称为光子的分立能量包的形式被吸收和发射，一个光子的能量由辐射的频率决定，E = hν，或等价地由其波长决定，E = hc/λ。",
   "forms": [
    {
     "id": "eq-photon-energy",
     "latex": "E=h\\nu=\\frac{hc}{\\lambda}",
     "ktex": "\\kE=h\\knu=\\frac{hc}{\\klam}",
     "condition": "one photon of electromagnetic radiation",
     "anchor": "6.1-photoelectric"
    }
   ]
  },
  {
   "id": "line-spectra",
   "kind": "idea",
   "section": "6.1",
   "name": "线状光谱",
   "terms": [
    "线状光谱"
   ],
   "statement": "经加热或通电激发的气体只在少数几个尖锐的波长处发光，而不是在一段不间断的波段上发光，每种元素都有自己的一组谱线。经典电磁理论预言的是连续光谱，无法解释这一现象。"
  },
  {
   "id": "wave-properties",
   "kind": "definition",
   "section": "6.1",
   "name": "波的性质",
   "statement": "每一种波，包括电磁辐射，都有波长，即两个相邻波峰或波谷之间的距离；有频率，即单位时间内通过某一点的周期数；还有振幅，即从波峰到波谷高度的一半。振幅与波的强度有关，对光而言，强度就是亮度。我们用波长和频率来描述光。"
  },
  {
   "id": "wave-speed-relation",
   "kind": "result",
   "section": "6.1",
   "name": "波速",
   "statement": "波的波长与频率之积就是它的速率，对真空中的电磁辐射而言，这一速率是常数 c。因此波长与频率成反比：一个增大，另一个就减小，由其中一个即可求出另一个。",
   "forms": [
    {
     "id": "eq-wave-speed",
     "latex": "c=\\lambda\\nu",
     "ktex": "c=\\klam\\knu",
     "condition": "electromagnetic radiation in a vacuum",
     "anchor": "6.1-wave-speed"
    }
   ]
  },
  {
   "id": "electromagnetic-spectrum",
   "kind": "idea",
   "section": "6.1",
   "name": "电磁波谱",
   "terms": [
    "电磁波谱"
   ],
   "statement": "电磁辐射的波长范围极其宽广，从 γ 射线和 X 射线，经紫外线、可见光和红外线，到微波和无线电波，可见光只占其中很小的一部分。沿波谱方向，波长减小时能量和频率增大，每个区域各有各的用途。"
  },
  {
   "id": "standing-waves-quantization",
   "kind": "idea",
   "section": "6.1",
   "name": "驻波与量子化",
   "statement": "驻波被限制在空间的某个区域内。两端固定的弦只能形成两端之间含有整数个半波长的波。这是量子化的一个例子，量子化是指只观察到某一性质的分立取值。两端之间不动的点是节点，节点的数目随波的能量增大而增多。"
  },
  {
   "id": "blackbody-radiation",
   "kind": "idea",
   "section": "6.1",
   "name": "黑体辐射与普朗克的量子化能量",
   "statement": "受热物体发出连续光谱，其分布只取决于温度，温度升高时，曲线的峰向较短的波长移动。经典理论预言强度在短波长处会无限增大，这就是紫外灾难；普朗克把振动能量限制为分立值 E = nhν，拟合了观测到的曲线，这是能量量子化的首次出现。",
   "forms": [
    {
     "id": "eq-planck-quantization",
     "latex": "E=nh\\nu,\\; n=1,\\;2,\\;3,\\;\\ldots",
     "ktex": "\\kE=nh\\knu,\\; n=1,\\;2,\\;3,\\;\\ldots",
     "condition": "the vibrating atoms of a blackbody, restricted to discrete energies for each frequency",
     "anchor": "6.1-blackbody"
    }
   ]
  },
  {
   "id": "photoelectric-effect",
   "kind": "idea",
   "section": "6.1",
   "name": "光电效应",
   "statement": "只有当光的频率高于某一阈值时，光才能从洁净的金属表面打出电子；被打出电子的动能随频率增大，而不随亮度增大，电子的数目则随亮度增大。爱因斯坦把光看作由光子组成的粒子流来解释这一现象，每个光子携带能量 hν，因此只有能量足够的光子才能使电子脱离金属。"
  },
  {
   "id": "wave-particle-duality",
   "kind": "idea",
   "section": "6.1",
   "name": "波粒二象性",
   "terms": [
    "波粒二象性"
   ],
   "statement": "光的某些行为，例如通过两条窄缝后形成的干涉条纹，只能用波来解释；另一些行为，例如光电效应，则只能用粒子来解释。光既有波的性质，又有粒子的性质，这称为波粒二象性。物质也表现出同样的二象性。"
  },
  {
   "id": "wave",
   "kind": "definition",
   "section": "6.1",
   "name": "波",
   "terms": [
    "波"
   ],
   "statement": "波是某种性质随时间或空间的振荡，它能把能量从一点输送到另一点。"
  },
  {
   "id": "wavelength",
   "kind": "definition",
   "section": "6.1",
   "name": "波长",
   "symbol": "λ",
   "terms": [
    "波长（λ）"
   ],
   "type": "wavelength",
   "statement": "波的波长是两个相邻波峰或波谷之间的距离。"
  },
  {
   "id": "frequency",
   "kind": "definition",
   "section": "6.1",
   "name": "频率",
   "symbol": "ν",
   "terms": [
    "频率（ν）"
   ],
   "type": "frequency",
   "statement": "波的频率是单位时间内通过空间中某一指定点的波的周期数（波峰数或波谷数）。"
  },
  {
   "id": "hertz",
   "kind": "definition",
   "section": "6.1",
   "name": "赫兹",
   "terms": [
    "赫兹（Hz）"
   ],
   "statement": "赫兹是频率的单位，每秒一个周期。",
   "forms": [
    {
     "id": "eq-hertz",
     "latex": "1\\ \\text{Hz} = 1\\ \\text{s}^{-1}"
    }
   ]
  },
  {
   "id": "amplitude",
   "kind": "definition",
   "section": "6.1",
   "name": "振幅",
   "terms": [
    "振幅"
   ],
   "statement": "波的振幅是它所引起位移的大小，即从波峰到波谷高度的一半。"
  },
  {
   "id": "intensity",
   "kind": "definition",
   "section": "6.1",
   "name": "强度",
   "terms": [
    "强度"
   ],
   "statement": "强度是波所携带能量的一种性质，与波的振幅有关，例如光的亮度或声音的响度。"
  },
  {
   "id": "electromagnetic-radiation",
   "kind": "definition",
   "section": "6.1",
   "name": "电磁辐射",
   "terms": [
    "电磁辐射"
   ],
   "statement": "电磁辐射是以波的形式传播的能量，这种波具有电场分量和磁场分量。"
  },
  {
   "id": "interference-pattern",
   "kind": "idea",
   "section": "6.1",
   "name": "干涉图样",
   "terms": [
    "干涉图样"
   ],
   "statement": "干涉图样是波的相长干涉和相消干涉所形成的明暗相间的条纹图案。"
  },
  {
   "id": "standing-wave",
   "kind": "definition",
   "section": "6.1",
   "name": "驻波",
   "terms": [
    "驻波"
   ],
   "statement": "驻波（又称定波）是局限在空间某一区域内的波，其波长是分立的，由该区域的边界决定。"
  },
  {
   "id": "node",
   "kind": "definition",
   "section": "6.1",
   "name": "节点",
   "terms": [
    "节点"
   ],
   "statement": "节点是驻波上振幅为零的任一点。在原子轨道中，节点是找到电子的概率为零的地方。"
  },
  {
   "id": "quantization",
   "kind": "definition",
   "section": "6.1",
   "name": "量子化",
   "symbol": "n_quantum",
   "terms": [
    "量子化"
   ],
   "statement": "量子化是指某一性质被限制在特定的分立值上，而不是连续的范围。"
  },
  {
   "id": "blackbody",
   "kind": "definition",
   "section": "6.1",
   "name": "黑体",
   "terms": [
    "黑体"
   ],
   "statement": "黑体是一种理想化的、能吸收全部入射电磁辐射的完美吸收体。受热时，它发出具有特征性的连续波长分布的辐射。"
  },
  {
   "id": "continuous-spectrum",
   "kind": "definition",
   "section": "6.1",
   "name": "连续光谱",
   "terms": [
    "连续光谱"
   ],
   "statement": "连续光谱是由一系列不间断的波长组成的电磁辐射，太阳发出的白光就是如此。"
  },
  {
   "id": "photon",
   "kind": "definition",
   "section": "6.1",
   "name": "光子",
   "terms": [
    "光子"
   ],
   "statement": "光子是电磁辐射最小可能的能量包，是光的粒子。"
  },
  {
   "id": "rydberg-equation",
   "kind": "axiom",
   "section": "6.1",
   "name": "里德伯公式",
   "statement": "氢光谱中所有谱线的波长都符合同一个经验公式：波长的倒数等于里德伯常量乘以两个整数倒数平方之差（n₁ 小于 n₂）。可见光区四条谱线的巴耳末公式是 n₁ = 2 的情形。",
   "forms": [
    {
     "id": "eq-rydberg",
     "latex": "\\frac{1}{\\lambda}=R_{\\infty}\\left(\\frac{1}{n_1^{\\,2}}-\\frac{1}{n_2^{\\,2}}\\right)",
     "ktex": "\\frac{1}{\\klam}=R_{\\infty}\\left(\\frac{1}{n_1^{\\,2}}-\\frac{1}{n_2^{\\,2}}\\right)",
     "condition": "every emission line of hydrogen, with n₁ and n₂ integers and n₁ < n₂",
     "anchor": "6.1-rydberg"
    },
    {
     "id": "eq-balmer",
     "latex": "\\frac{1}{\\lambda}=k\\left(\\frac{1}{4}-\\frac{1}{n^{2}}\\right),\\; n=3,\\;4,\\;5,\\;6",
     "ktex": "\\frac{1}{\\klam}=k\\left(\\frac{1}{4}-\\frac{1}{n^{2}}\\right),\\; n=3,\\;4,\\;5,\\;6",
     "condition": "the four visible lines of hydrogen, as Balmer found them empirically",
     "anchor": "6.1-rydberg"
    }
   ]
  },
  {
   "id": "classical-atom-instability",
   "kind": "idea",
   "section": "6.2",
   "name": "行星式原子的不稳定性",
   "statement": "在行星式的图像中，电子绕原子核运动，就像行星绕太阳运动一样。处在这样的轨道上的电子时刻在改变方向，因而始终在做加速运动，而按照经典电磁理论，做加速运动的电荷必定连续不断地辐射。这样，轨道会不断缩小，直到电子螺旋式地落入原子核，于是每个原子在本质上都是不稳定的。"
  },
  {
   "id": "bohr-stationary-states",
   "kind": "axiom",
   "section": "6.2",
   "name": "玻尔的定态",
   "statement": "处在原子某一允许轨道上的电子完全不辐射；只有当它从一个允许轨道跃迁到另一个允许轨道时，才发射或吸收辐射。这些轨道的能量是量子化的：电子只能具有某些分立的能量，而不能取它们之间的任何值。"
  },
  {
   "id": "bohr-energy-levels",
   "kind": "result",
   "section": "6.2",
   "name": "玻尔能级",
   "type": "energy",
   "statement": "第 n 个轨道上电子的能量等于 −k 乘以核电荷的平方，再除以 n 的平方。常数 k 汇集了电子质量、电子电荷和普朗克常量。能量为负，是因为它们是从 E = 0 算起的，E = 0 是电离极限，即电子已完全脱离原子核之处。随着 n 增大，能量向零靠拢，所以能量阶梯的横档在底部相距很远，在顶部则靠得很近。使基态氢原子电离所需的能量就是 k 本身。",
   "forms": [
    {
     "id": "eq-bohr-energy",
     "latex": "E_n=-\\frac{kZ^2}{n^2}\\,,\\; n=1,\\;2,\\;3,\\;\\ldots",
     "ktex": "\\kEn=-\\frac{kZ^2}{n^2}\\,,\\; n=1,\\;2,\\;3,\\;\\ldots",
     "condition": "a one-electron atom or ion of nuclear charge Z",
     "anchor": "6.2-hydrogen-like"
    },
    {
     "id": "eq-bohr-energy-hydrogen",
     "latex": "E_n=-\\frac{k}{n^2}\\,,\\; n=1,\\;2,\\;3,\\;\\ldots",
     "ktex": "\\kEn=-\\frac{k}{n^2}\\,,\\; n=1,\\;2,\\;3,\\;\\ldots",
     "condition": "hydrogen, for which the nuclear charge is +1",
     "anchor": "6.2-stationary-states"
    },
    {
     "id": "eq-ionization-limit",
     "latex": "\\Delta E=E_{n\\;\\longrightarrow\\;\\infty}-E_1=0+k=k",
     "ktex": "\\kdE=\\kE_{n\\;\\longrightarrow\\;\\infty}-\\kE_{1}=0+k=k",
     "condition": "hydrogen in its ground state, the electron removed to an infinite distance",
     "anchor": "6.2-orbit-radius"
    }
   ]
  },
  {
   "id": "ground-and-excited-states",
   "kind": "definition",
   "section": "6.2",
   "name": "基态与激发态",
   "statement": "电子能量最低的原子处于基态，例如电子处在 n = 1 轨道上的氢原子。外界的能量可以把电子送到 n 更大的轨道上，此时原子处于激发态。"
  },
  {
   "id": "photon-emission-absorption",
   "kind": "result",
   "section": "6.2",
   "name": "光子的发射与吸收",
   "statement": "电子在两个允许轨道之间跃迁时，原子发射或吸收一个光子，光子的能量等于这两个轨道能量之差。落到较低的轨道上就发射光子，吸收光子则使电子升到较高的轨道。能量既不能被创造，也不能被消灭，所以把电子从一个能级升到另一个能级所需的能量，等于它返回时释放的能量。我们取这一差值的绝对值，因为频率和波长总是正数。",
   "forms": [
    {
     "id": "eq-photon-energy-difference",
     "latex": "|\\Delta E|=|E_{\\text{f}}-E_{\\text{i}}|=h\\nu=\\frac{hc}{\\lambda}",
     "ktex": "|\\kdE|=|\\kEf-\\kEi|=h\\knu=\\frac{hc}{\\klam}",
     "condition": "the electron moves between two allowed orbits, so that one photon carries the whole difference",
     "anchor": "6.2-stationary-states"
    }
   ]
  },
  {
   "id": "hydrogen-like-ions",
   "kind": "idea",
   "section": "6.2",
   "name": "类氢原子和类氢离子",
   "statement": "玻尔模型只跟踪一个电子，所以它同样适用于 He⁺、Li²⁺、Be³⁺ 以及其他单电子离子，这些离子与氢的区别只在于核电荷。有两个电子的氦已经超出了该模型的范围，因为模型没有说明两个电子如何相互作用。"
  },
  {
   "id": "bohr-orbit-radius",
   "kind": "result",
   "section": "6.2",
   "name": "玻尔轨道半径",
   "type": "length",
   "statement": "允许轨道的半径与量子数的平方成正比，并随核电荷的增大而减小。半径以玻尔半径为单位来量度，玻尔半径是氢基态轨道的半径。电子的能量越高，被发现的位置离原子核越远。静电引力随距离增大而减弱，所以离核越远的电子被束缚得越松。",
   "forms": [
    {
     "id": "eq-bohr-radius",
     "latex": "r=\\frac{n^2}{Z}\\,a_0",
     "condition": "a one-electron atom or ion of nuclear charge Z",
     "anchor": "6.2-orbit-radius"
    }
   ]
  },
  {
   "id": "rydberg-constant-recovered",
   "kind": "result",
   "section": "6.2",
   "name": "由玻尔模型得到的里德伯常量",
   "statement": "把玻尔模型的量子化能量代入光子关系式，得到波长倒数的表达式，其形式与里德伯公式相同，里德伯常量等于 k 除以 hc。玻尔的理论值与实验值符合得极好。",
   "forms": [
    {
     "id": "eq-rydberg-from-bohr",
     "latex": "\\frac{1}{\\lambda}=\\frac{k}{hc}\\left(\\frac{1}{n_1^{\\,2}}-\\frac{1}{n_2^{\\,2}}\\right)",
     "ktex": "\\frac{1}{\\klam}=\\frac{k}{hc}\\left(\\frac{1}{n_1^{\\,2}}-\\frac{1}{n_2^{\\,2}}\\right)",
     "condition": "hydrogen, and the quotient k/hc is the Rydberg constant",
     "anchor": "6.2-rydberg-recovered"
    }
   ]
  },
  {
   "id": "calculating-bohr-transition-energies",
   "kind": "skill",
   "section": "6.2",
   "name": "计算跃迁能量",
