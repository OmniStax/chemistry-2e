  },
  {
   "id": "single-bond",
   "kind": "definition",
   "section": "7.3",
   "name": "单键",
   "terms": [
    "单键"
   ],
   "statement": "单键是两个原子之间共用一对电子的键。"
  },
  {
   "id": "double-bond",
   "kind": "definition",
   "section": "7.3",
   "name": "双键",
   "terms": [
    "双键"
   ],
   "statement": "双键是两个原子之间共用两对电子的共价键。"
  },
  {
   "id": "triple-bond",
   "kind": "definition",
   "section": "7.3",
   "name": "三键",
   "terms": [
    "三键"
   ],
   "statement": "三键是两个原子之间共用三对电子的共价键。"
  },
  {
   "id": "free-radical",
   "kind": "definition",
   "section": "7.3",
   "name": "自由基",
   "terms": [
    "自由基"
   ],
   "statement": "自由基是含有奇数个电子的分子。"
  },
  {
   "id": "hypervalent-molecule",
   "kind": "definition",
   "section": "7.3",
   "name": "超价分子",
   "terms": [
    "超价分子"
   ],
   "statement": "超价分子至少含有一个价层电子多于八个的主族元素。"
  },
  {
   "id": "formal-charge",
   "kind": "skill",
   "section": "7.4",
   "name": "计算形式电荷",
   "statement": "路易斯结构中原子的形式电荷，等于自由原子的价电子数，减去其孤电子对的电子数，再减去其成键电子数的一半。分子的形式电荷之和为零，离子的形式电荷之和等于其电荷。"
  },
  {
   "id": "formal-charge-guidelines",
   "kind": "skill",
   "section": "7.4",
   "name": "根据形式电荷选择路易斯结构",
   "statement": "当可以写出不止一种路易斯结构时，较优的一种形式电荷为零，否则其非零形式电荷最小，相邻原子的形式电荷为零或符号相反，且任何负的形式电荷都在电负性较大的原子上。这些准则解释了为什么电负性最小的原子通常处于中心位置。"
  },
  {
   "id": "resonance",
   "kind": "idea",
   "section": "7.4",
   "name": "共振式和共振杂化体",
   "terms": [
    "共振"
   ],
   "statement": "当可以写出两个或更多个原子排布相同的路易斯结构时，其中任何一个都不能单独描述这个分子；电子的实际分布是它们的平均，即共振杂化体。分子并不在各共振式之间来回转换，所以亚硝酸根离子的两个 N–O 键和碳酸根离子的三个 C–O 键，经测定都是相同的。"
  },
  {
   "id": "formal-charge-of-atom",
   "kind": "definition",
   "section": "7.4",
   "name": "形式电荷",
   "terms": [
    "形式电荷"
   ],
   "statement": "原子的形式电荷，是每个键的电子被平均共用时该原子所带的电荷：中性原子的价电子数，减去其孤电子对的电子数，再减去其成键电子数的一半。",
   "forms": [
    {
     "id": "eq-formal-charge",
     "latex": "\\text{formal charge}=\\text{\\# valence shell electrons (free atom)}-\\text{\\# lone pair electrons}-\\frac{1}{2}\\,\\text{\\# bonding electrons}",
     "anchor": "7.4-calculating-formal-charge"
    }
   ]
  },
  {
   "id": "molecular-structure",
   "kind": "definition",
   "section": "7.4",
   "name": "分子构型",
   "terms": [
    "分子构型"
   ],
   "statement": "分子或离子的分子构型，是其原子的排布，不考虑其孤电子对。"
  },
  {
   "id": "resonance-forms",
   "kind": "definition",
   "section": "7.4",
   "name": "共振式",
   "terms": [
    "共振式"
   ],
   "statement": "共振式是原子排布相同而电子排布不同的两个或更多个路易斯结构。"
  },
  {
   "id": "resonance-hybrid",
   "kind": "definition",
   "section": "7.4",
   "name": "共振杂化体",
   "terms": [
    "共振杂化体"
   ],
   "statement": "共振杂化体是各个路易斯结构所示共振式的平均，是分子中电子的实际分布。"
  },
  {
   "id": "bond-energy",
   "kind": "definition",
   "section": "7.5",
   "name": "键能",
   "symbol": "D_bond",
   "terms": [
    "键能"
   ],
   "type": "energy",
   "statement": "共价键的强度用键能来衡量，即断开气态分子中 1 mol 该种键所需的能量，对双原子分子来说就是其解离的标准焓变。在含有多个同类键的分子中，表中所列的值是平均值，因为断开第一个键所需的能量与断开其余的键并不相同。",
   "forms": [
    {
     "id": "eq-bond-energy",
     "latex": "\\text{XY}(g)\\longrightarrow\\text{X}(g)+\\text{Y}(g)\\qquad D_{\\text{X–Y}}=\\Delta H^{\\circ}",
     "ktex": "\\text{XY}(g)\\longrightarrow\\text{X}(g)+\\text{Y}(g)\\qquad \\kDbond_{\\text{X–Y}}=\\kdHo",
     "condition": "a diatomic molecule XY in the gas phase",
     "anchor": "7.5-bond-strength"
    }
   ]
  },
  {
   "id": "bond-strength-and-length",
   "kind": "result",
   "section": "7.5",
   "name": "键的强度与键长",
   "statement": "两个原子共用的电子对越多，它们之间的键就越强、越短，所以在同样的两个原子之间，三键比双键更强、更短，双键比单键更强、更短。当一个原子与同族成员成键时，键在族中自上而下逐渐变弱。"
  },
  {
   "id": "enthalpy-from-bond-energies",
   "kind": "skill",
   "section": "7.5",
   "name": "由键能估算焓变",
   "statement": "反应的焓变近似等于断开反应物所有键所需的能量，减去形成生成物所有键所放出的能量。这一估算需要所有物种的路易斯结构，以便知道哪些键是单键、双键或三键；由于键能是平均值，所以估算是粗略的。",
   "forms": [
    {
     "id": "eq-enthalpy-bond-energies",
     "latex": "\\Delta H=\\sum D_{\\text{bonds broken}}-\\sum D_{\\text{bonds formed}}",
     "ktex": "\\kdH=\\sum \\kDbond_{\\text{bonds broken}}-\\sum \\kDbond_{\\text{bonds formed}}",
     "condition": "an estimate from average bond energies, for a reaction of gases",
     "anchor": "7.5-enthalpy"
    }
   ]
  },
  {
   "id": "lattice-energy",
   "kind": "definition",
   "section": "7.5",
   "name": "晶格能",
   "symbol": "ΔH_lattice",
   "terms": [
    "晶格能"
   ],
   "type": "energy",
   "statement": "离子化合物的晶格能，是把 1 mol 该固体分离成气态离子所需的能量，按本书采用的约定是正值。它度量把离子固体维系在一起的吸引的强度，比共价键的键能大得多，因为它是每个离子与整个晶格相互作用之和。",
   "forms": [
    {
     "id": "eq-lattice-energy-definition",
     "latex": "\\text{MX}(s)\\longrightarrow\\text{M}^{n+}(g)+\\text{X}^{n-}(g)\\qquad \\Delta H_{\\text{lattice}}",
     "ktex": "\\text{MX}(s)\\longrightarrow\\text{M}^{n+}(g)+\\text{X}^{n-}(g)\\qquad \\kdHlat",
     "anchor": "7.5-lattice"
    }
   ]
  },
  {
   "id": "lattice-energy-trends",
   "kind": "result",
   "section": "7.5",
   "name": "晶格能的变化规律",
   "statement": "由库仑定律导出，晶格能与离子电荷的乘积成正比，与离子间的距离成反比。两个电荷都加倍，晶格能变为四倍，所以 MgO 的晶格能接近 LiF 的四倍；离子越小，晶格能越大，所以 MgF2 的晶格能超过 MgI2。",
   "forms": [
    {
     "id": "eq-lattice-energy-coulomb",
     "latex": "\\Delta H_{\\text{lattice}}=\\frac{C(Z^{+})(Z^{-})}{R_{\\text{o}}}",
     "ktex": "\\kdHlat=\\frac{C(Z^{+})(Z^{-})}{R_{\\text{o}}}",
     "condition": "an ionic crystal; C depends on the type of crystal structure",
     "anchor": "7.5-lattice-trends"
    }
   ]
  },
  {
   "id": "born-haber-cycle",
   "kind": "skill",
   "section": "7.5",
   "name": "应用玻恩-哈伯循环",
   "statement": "晶格能不能直接测量。玻恩-哈伯循环把由单质生成离子固体的过程分成焓为已知的若干步：金属的升华、非金属的解离、金属原子的电离、非金属原子的电子亲和，以及晶格能的负值。根据盖斯定律，这些步骤相加等于生成焓，所以其中任何一步都可以由其余各步求得。"
  },
  {
   "id": "born-haber-thermochemical-cycle",
   "kind": "definition",
   "section": "7.5",
   "name": "玻恩-哈伯循环",
   "terms": [
    "玻恩-哈伯循环"
   ],
   "statement": "玻恩-哈伯循环是一个热化学循环，把由单质生成离子固体的各个能量步骤联系起来：金属的升华、非金属的解离、金属原子的电离、非金属原子的电子亲和，以及晶格的形成。",
   "forms": [
    {
     "id": "eq-born-haber",
     "latex": "\\Delta H_{\\text{f}}^{\\circ}=\\Delta H_{s}^{\\circ}+\\tfrac{1}{2}D+IE+(EA)+(-\\Delta H_{\\text{lattice}})",
     "ktex": "\\kdHf=\\kdHs+\\tfrac{1}{2}\\kDbond+\\kIE+(\\kEA)+(-\\kdHlat)",
     "condition": "the formation of an ionic solid MX from a solid metal and a diatomic gaseous nonmetal, as for CsF",
     "anchor": "7.5-born-haber"
    }
   ]
  }
 ],
