 "concepts": [
  {
   "id": "bond-angle-and-bond-distance",
   "kind": "definition",
   "section": "7.6",
   "name": "键角与键长",
   "statement": "分子的形状由原子核之间的距离和键与键之间的夹角来描述。键角是共用一个原子的两个键之间的夹角，以度为单位；键长是两个成键原子的原子核之间的距离，以埃或皮米为单位。"
  },
  {
   "id": "vsepr-theory",
   "kind": "idea",
   "section": "7.6",
   "name": "价层电子对互斥理论",
   "terms": [
    "价层电子对互斥理论（VSEPR）"
   ],
   "statement": "VSEPR 理论只凭一个假设来预测分子的形状：中心原子价层中的高电子密度区域，无论是成键电子对还是孤电子对，都相互排斥，并取彼此相距最远的排布。该理论只考虑电子对之间的排斥，尽管核与核之间的排斥以及核与电子之间的吸引也会影响分子最终采取的排布。"
  },
  {
   "id": "electron-pair-geometry",
   "kind": "definition",
   "section": "7.6",
   "name": "电子对构型",
   "terms": [
    "电子对构型"
   ],
   "statement": "电子对构型是中心原子周围所有电子密度区域的排布，只有五种：两个区域为直线形，三个为平面三角形，四个为四面体形，五个为三角双锥形，六个为八面体形。一个单键、一个双键和一个三键各算作一个区域。"
  },
  {
   "id": "molecular-structure-versus-electron-pair-geometry",
   "kind": "idea",
   "section": "7.6",
   "name": "分子构型不同于电子对构型",
   "statement": "电子对构型描述所有电子密度区域（键和孤电子对一并计入）的位置；分子构型描述的是原子的位置，对孤电子对不置一词。中心原子没有孤电子对时，两者相同；只要有孤电子对，两者便不同。所以甲烷是四面体形，而氨虽有同样的四个区域，却是三角锥形，水则是 V 形。"
  },
  {
   "id": "electron-pair-repulsion-order",
   "kind": "result",
   "section": "7.6",
   "name": "电子对排斥作用的强弱顺序",
   "statement": "理想的角度只是近似值，因为各个电子密度区域的大小并不相同。孤电子对的排斥作用比成键电子对强，它所占的空间比三键大，三键比双键大，双键又比单键大。正是这一顺序解释了键角与理想角度之间的微小偏差，并在有不止一种排布可能时决定取哪一种。",
   "forms": [
    {
     "id": "eq-repulsion-order",
     "latex": "\\text{lone pair-lone pair}>\\text{lone pair-bonding pair}>\\text{bonding pair-bonding pair}",
     "anchor": "7.6-repulsion-order"
    },
    {
     "id": "eq-domain-size-order",
     "latex": "\\text{lone pair}>\\text{triple bond}>\\text{double bond}>\\text{single bond}",
     "anchor": "7.6-repulsion-order"
    }
   ]
  },
  {
   "id": "axial-and-equatorial-positions",
   "kind": "definition",
   "section": "7.6",
   "name": "轴向位置与赤道位置",
   "statement": "在直线形、平面三角形和四面体形的排布中，每个端位位置都是等价的，所以孤电子对占据哪一个无关紧要。三角双锥有两种位置：轴向位置周围是 90° 的夹角，赤道位置因夹角为 120° 而有更大的空间。孤电子对总是占据赤道位置；在有两对孤电子对的八面体中，这两对相距 180°，这就是 ClF3 为 T 形、XeF4 为平面正方形的原因。"
  },
  {
   "id": "predict-molecular-structure",
   "kind": "skill",
   "section": "7.6",
   "name": "预测电子对构型和分子构型",
   "statement": "要预测分子构型，先写出路易斯结构，数出中心原子周围的电子密度区域数。由此得出电子对构型，再根据孤电子对的数目给分子构型命名。若有不止一种排布可能，选择排斥最小的一种。对于没有单一中心原子的分子，依次处理每个内部原子，各有各的局部构型。"
  },
  {
   "id": "bond-dipole-moment",
   "kind": "definition",
   "section": "7.6",
   "name": "键偶极矩",
   "symbol": "μ",
   "terms": [
    "键偶极矩"
   ],
   "type": "dipole-moment",
   "statement": "极性共价键使一个原子带部分正电荷，另一个原子带部分负电荷。键偶极矩度量这种电荷分离，它等于部分电荷的大小与它们之间距离的乘积。我们把它画成一个从电负性较小的原子指向电负性较大的原子的矢量，正端标一个小加号，长度与电负性差成正比。",
   "forms": [
    {
     "id": "eq-dipole-moment",
     "latex": "\\mu = Qr",
     "anchor": "7.6-bond-dipole"
    }
   ]
  },
  {
   "id": "molecular-polarity",
   "kind": "skill",
   "section": "7.6",
   "name": "判断分子的极性",
   "statement": "只有当分子至少含有一个极性键，且各键矩按三维矢量相加后不能抵消时，分子才是极性的。因此，几何形状与电负性同样重要：二氧化碳有两个方向相反的极性键，是非极性分子；水有同样的两个键，但彼此弯向对方，是极性分子。BF3、CH4、PF5 和 SF6 等高度对称的分子，也由于同样的原因是非极性的；极性分子则是在电场中会取向排列、且易溶于极性溶剂的分子。"
  },
  {
