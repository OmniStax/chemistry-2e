  },
  {
   "id": "freezing",
   "kind": "definition",
   "section": "10.3",
   "name": "凝固",
   "terms": [
    "凝固"
   ],
   "statement": "凝固是由液态变为固态的变化。"
  },
  {
   "id": "sublimation",
   "kind": "definition",
   "section": "10.3",
   "name": "升华",
   "terms": [
    "升华"
   ],
   "statement": "升华是由固态直接变为气态的变化。"
  },
  {
   "id": "deposition",
   "kind": "definition",
   "section": "10.3",
   "name": "凝华",
   "terms": [
    "凝华"
   ],
   "statement": "凝华是由气态直接变为固态的变化。"
  },
  {
   "id": "dynamic-equilibrium",
   "kind": "definition",
   "section": "10.3",
   "name": "动态平衡",
   "terms": [
    "动态平衡"
   ],
   "statement": "动态平衡是体系中相反的过程以相同速率进行的状态，两个过程都在持续，但整体上没有任何变化。"
  },
  {
   "id": "vapor-pressure",
   "kind": "definition",
   "section": "10.3",
   "name": "蒸气压",
   "symbol": "P",
   "terms": [
    "蒸气压"
   ],
   "type": "pressure",
   "statement": "液体或固体的蒸气压，又称平衡蒸气压，是在给定温度下，其蒸气与它处于平衡时所产生的压强。"
  },
  {
   "id": "normal-boiling-point",
   "kind": "definition",
   "section": "10.3",
   "name": "正常沸点",
   "terms": [
    "正常沸点"
   ],
   "statement": "液体的正常沸点是其蒸气压等于 1 atm（760 torr）时的温度。"
  },
  {
   "id": "melting-point",
   "kind": "definition",
   "section": "10.3",
   "name": "熔点与凝固点",
   "terms": [
    "凝固点",
    "熔点"
   ],
   "statement": "物质的熔点是其固相与液相处于平衡时的温度。同一温度，在冷却液体时达到，就称为凝固点。"
  },
  {
   "id": "phase-diagram",
   "kind": "definition",
   "section": "10.4",
   "name": "相图",
   "terms": [
    "相图"
   ],
   "statement": "相图把物质的液–气、固–液和固–气平衡的压强–温度曲线合在一起。每个区域是在该条件下稳定存在的相，每条曲线给出转变温度随压强的变化。"
  },
  {
   "id": "read-phase-diagram",
   "kind": "skill",
   "section": "10.4",
   "name": "读相图",
   "statement": "要确定物质的状态，就在相图上找到该温度和压强，读出所在的区域；要找出在恒压下加热或在恒温下加压时发生的相变，就沿水平线或竖直线移动，并记下它所穿过的曲线。"
  },
  {
   "id": "triple-point",
   "kind": "definition",
   "section": "10.4",
   "name": "三相点",
   "terms": [
    "三相点"
   ],
   "statement": "三相点是固、液、气三相处于平衡时的温度和压强。压强低于三相点压强时，物质不能以液体存在，所以会升华；冷冻干燥和干冰都依赖于此。"
  },
  {
   "id": "solid-liquid-curve-slope",
   "kind": "idea",
   "section": "10.4",
   "name": "固–液曲线的斜率",
   "statement": "大多数物质的固–液曲线斜率为正，所以熔点随压强升高而升高；水的这条曲线斜率略为负，所以压强会降低冰的熔点。"
  },
  {
   "id": "critical-point-and-supercritical-fluid",
   "kind": "idea",
   "section": "10.4",
   "name": "临界点与超临界流体",
   "statement": "液–气曲线终止于临界点。温度高于临界温度时，无论施加多大压强都不能使气体液化，此时物质是超临界流体，其性质介于液体和气体之间。"
  },
  {
   "id": "critical-point",
   "kind": "definition",
   "section": "10.4",
   "name": "临界点",
   "terms": [
    "临界点"
   ],
   "statement": "物质的临界点是这样的温度和压强：高于它，气体就不能凝结为液体；它是该物质液–气曲线的终点。"
  },
  {
   "id": "supercritical-fluid",
   "kind": "definition",
   "section": "10.4",
   "name": "超临界流体",
   "terms": [
    "超临界流体"
   ],
   "statement": "超临界流体是温度和压强高于其临界点的物质，其性质介于气体和液体之间。"
  },
  {
   "id": "crystalline-and-amorphous-solids",
   "kind": "idea",
   "section": "10.5",
   "name": "晶态固体与无定形固体",
   "statement": "在晶态固体中，粒子按确定的重复图案排列。每个粒子所受的作用力相同，所以固体在精确的温度下熔化。在无定形固体中，粒子无规则排列，吸引作用各不相同，所以固体在一定温度范围内逐渐软化。"
  },
  {
   "id": "types-of-crystalline-solids",
   "kind": "idea",
   "section": "10.5",
   "name": "晶态固体的类型",
   "statement": "晶态固体按粒子之间的作用力分类，这些作用力也解释了它们的性质：离子固体硬而脆，只有熔融时才导电；金属固体是有延展性的导体；共价网状固体非常硬，熔点极高；分子固体较软，熔点较低。"
  },
  {
   "id": "classify-crystalline-solid",
   "kind": "skill",
   "section": "10.5",
   "name": "晶态固体的分类",
   "statement": "由化学式可以确定粒子的种类（离子、金属原子、构成网状结构的原子或分子），从而确定固体的类型；由硬度、导电性和熔点等观测到的性质，也可以反推固体的类型。"
  },
  {
   "id": "crystal-defects",
   "kind": "idea",
   "section": "10.5",
   "name": "晶体缺陷",
   "statement": "晶体的重复图案中可能含有缺陷：粒子缺失造成的空位，位于间隙位置的粒子，以及替代晶格中原有粒子的杂质。缺陷会改变物理性质，在硅中掺杂以制造半导体，就是有意引入缺陷。"
  },
  {
