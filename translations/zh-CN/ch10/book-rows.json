 "concepts": [
  {
   "id": "intermolecular-versus-intramolecular-forces",
   "kind": "definition",
   "section": "10.1",
   "name": "分子间作用力与分子内作用力",
   "statement": "分子内作用力是把分子内部各原子维系在一起的化学键；分子间作用力是分子之间的吸引作用，它们决定着物质的许多物理性质。小分子之间的分子间作用力通常比分子内的化学键弱得多。"
  },
  {
   "id": "phase-from-imf-and-kinetic-energy",
   "kind": "idea",
   "section": "10.1",
   "name": "相与分子间作用力",
   "statement": "分子间作用力使粒子彼此靠近，而粒子的动能则使它们分开，所以物质处于哪一相，取决于二者的平衡。冷却气体或压缩气体，可以让吸引作用占上风，气体就凝结；把液体冷却到足够低的温度，液体就凝固。"
  },
  {
   "id": "dispersion-forces",
   "kind": "definition",
   "section": "10.1",
   "name": "伦敦色散力",
   "terms": [
    "色散力"
   ],
   "statement": "原子或分子中的电子在不断运动，因此它可能出现瞬时偶极，瞬时偶极又使相邻粒子产生诱导偶极；这两个暂时的偶极相互吸引。这种色散力存在于所有凝聚相中，与原子或分子的种类无关。"
  },
  {
   "id": "polarizability-and-dispersion-strength",
   "kind": "result",
   "section": "10.1",
   "name": "极化率与色散力",
   "statement": "原子越大，价电子离原子核越远，所受束缚越松，电子云就越容易变形；极化率越大的粒子，色散力越大，熔点和沸点也越高。"
  },
  {
   "id": "shape-and-dispersion-strength",
   "kind": "result",
   "section": "10.1",
   "name": "分子形状与色散力",
   "statement": "分子式相同的分子，色散力也可能不同：细长的分子与相邻分子的接触面积比紧凑的分子大，因而所受的吸引更强。"
  },
  {
   "id": "dipole-dipole-attraction",
   "kind": "definition",
   "section": "10.1",
   "name": "偶极–偶极吸引力",
   "terms": [
    "偶极–偶极吸引力"
   ],
   "statement": "极性分子一端带部分正电荷，另一端带部分负电荷，一个极性分子的正端会吸引另一个极性分子的负端。这些吸引作用叠加在色散力之上，所以极性物质的沸点高于质量相近的非极性物质。"
  },
  {
   "id": "hydrogen-bonding",
   "kind": "definition",
   "section": "10.1",
   "name": "氢键",
   "terms": [
    "氢键"
   ],
   "statement": "当氢与氟、氧或氮成键时，电负性的巨大差异和原子的小尺寸使部分电荷高度集中，它与邻近分子中类似基团之间的吸引，是一种特别强的偶极–偶极吸引力，称为氢键。氢键比共价键弱得多，但比其他分子间吸引作用强。"
  },
  {
   "id": "rank-by-intermolecular-forces",
   "kind": "skill",
   "section": "10.1",
   "name": "沸点高低的排序",
   "statement": "比较物质时，先由其结构判断各自可能存在的作用力：色散力总是存在，分子有极性则有偶极–偶极吸引力，含 H–F、H–O 或 H–N 基团则有氢键。大小相近时，作用力较强的物质沸点较高；作用力类型相同时，分子较大的沸点较高。"
  },
  {
   "id": "intermolecular-force",
   "kind": "definition",
   "section": "10.1",
   "name": "分子间作用力",
   "terms": [
    "分子间作用力"
   ],
   "statement": "分子间作用力是原子、分子或离子之间的非共价吸引力。分子间作用力远比分子内的化学键弱，但它们决定着许多物理性质。"
  },
  {
   "id": "van-der-waals-force",
   "kind": "definition",
   "section": "10.1",
   "name": "范德华力",
   "terms": [
    "范德华力"
   ],
   "statement": "范德华力是分子之间的吸引力或排斥力，这个名称涵盖偶极–偶极吸引力、偶极–诱导偶极吸引力和伦敦色散力。"
  },
  {
   "id": "instantaneous-dipole",
   "kind": "definition",
   "section": "10.1",
   "name": "瞬时偶极",
   "terms": [
    "瞬时偶极"
   ],
   "statement": "瞬时偶极是原子或分子中的电子恰好分布不均匀时，在极短时间内存在的暂时偶极。"
  },
  {
   "id": "induced-dipole",
   "kind": "definition",
   "section": "10.1",
   "name": "诱导偶极",
   "terms": [
    "诱导偶极"
   ],
   "statement": "诱导偶极是原子或分子的电子受到相邻原子或分子的瞬时偶极扭曲而形成的暂时偶极。"
  },
  {
   "id": "polarizability",
   "kind": "definition",
   "section": "10.1",
   "name": "极化率",
   "terms": [
    "极化率"
   ],
   "statement": "极化率衡量电荷使原子或分子的电子云发生变形的难易程度。价电子束缚较松的较大原子和分子，极化率较大。"
  },
  {
   "id": "viscosity",
   "kind": "definition",
   "section": "10.2",
   "name": "黏度",
   "terms": [
    "黏度"
   ],
   "statement": "液体的黏度是它对流动的阻力。分子结构复杂、分子间作用力强的液体黏度较大；温度升高、分子运动加快时，黏度减小。"
  },
  {
   "id": "cohesive-and-adhesive-forces",
   "kind": "idea",
   "section": "10.2",
   "name": "内聚力与黏附力",
   "statement": "内聚力是液体中相同分子之间的吸引力；黏附力是液体与不同分子（例如固体表面的分子）之间的吸引力。二者的相对强弱决定液体能否润湿某个表面，以及弯月面向哪个方向弯曲。"
  },
  {
   "id": "surface-tension",
   "kind": "definition",
   "section": "10.2",
   "name": "表面张力",
   "symbol": "T_surf",
   "terms": [
    "表面张力"
   ],
   "type": "surface-tension",
   "statement": "液体表面的分子受到的相邻分子的吸引，只有液体内部分子的大约一半，所以液体总是收缩成最小的表面。表面张力是增大液体表面积所需的能量；它使小液滴呈球形，也使水黾能站在水面上。"
  },
  {
   "id": "capillary-action",
   "kind": "definition",
   "section": "10.2",
   "name": "毛细现象",
   "terms": [
    "毛细现象"
   ],
   "statement": "当液体与细管或多孔材料之间的黏附力很强，并与液体内部的内聚力相配合时，液体会克服重力向上流动，直到液体的重量与吸引力平衡为止。管越细，液体上升得越高。"
  },
  {
   "id": "capillary-rise-equation",
   "kind": "result",
   "section": "10.2",
   "name": "毛细上升",
   "statement": "液体在毛细管中上升的高度，与表面张力及接触角的余弦成正比，与毛细管的半径及液体的密度成反比。水在玻璃管中的接触角为 0°。",
   "forms": [
    {
     "id": "eq-capillary-rise",
     "latex": "h=\\frac{2T\\cos\\theta}{r\\rho g}",
     "condition": "a liquid in a capillary tube of radius r",
     "anchor": "10.2-capillary-rise"
    }
   ]
  },
  {
   "id": "cohesive-force",
   "kind": "definition",
   "section": "10.2",
   "name": "内聚力",
   "terms": [
    "内聚力"
   ],
   "statement": "内聚力是相同分子之间的吸引力，例如液体分子之间的吸引力。"
  },
  {
   "id": "adhesive-force",
   "kind": "definition",
   "section": "10.2",
   "name": "黏附力",
   "terms": [
    "黏附力"
   ],
   "statement": "黏附力是本性不同的分子之间的吸引力，例如液体与其所接触的表面之间的吸引力。"
  },
  {
   "id": "vapor-pressure-dynamic-equilibrium",
   "kind": "idea",
   "section": "10.3",
   "name": "蒸气压与动态平衡",
   "statement": "在密闭容器中，液体不断汽化，直到凝结速率等于汽化速率；此后液体和蒸气的量不再变化，但分子仍在相互交换。处于这种动态平衡时蒸气的压强就是该液体的蒸气压，它与表面积和容器大小无关。"
  },
  {
   "id": "vapor-pressure-and-imf",
   "kind": "result",
   "section": "10.3",
   "name": "蒸气压与分子间作用力",
   "statement": "较强的分子间吸引作用阻碍汽化，并有利于气体分子被重新捕获，所以分子间作用力较强的液体，蒸气压较低。"
  },
  {
   "id": "vapor-pressure-and-temperature",
   "kind": "result",
   "section": "10.3",
   "name": "蒸气压随温度升高而增大",
   "statement": "温度越高，具有足够动能逸出液体的分子所占的比例越大，逸出的分子运动也越快，所以蒸气压增大。"
  },
  {
   "id": "boiling-point",
   "kind": "definition",
   "section": "10.3",
   "name": "沸点与正常沸点",
   "terms": [
    "沸点"
   ],
   "statement": "当液体的蒸气压等于其上方气体的压强时，液体沸腾，所以沸点取决于周围的压强；正常沸点是 1 atm（101.3 kPa）下的沸点。蒸气压曲线可以看作各压强下的沸点曲线。"
  },
  {
   "id": "clausius-clapeyron-equation",
   "kind": "result",
   "section": "10.3",
   "name": "克劳修斯–克拉珀龙方程",
   "terms": [
    "克劳修斯–克拉珀龙方程"
   ],
   "statement": "液体的蒸气压随温度呈指数变化，$P = Ae^{-\\Delta H_{\\text{vap}}/RT}$，所以 ln P 对 1/T 作图是一条直线，斜率为 −ΔH<sub>vap</sub>/R。温度必须用开尔文表示。",
   "forms": [
    {
     "id": "eq-clausius-clapeyron",
     "latex": "P=Ae^{-\\Delta H_{\\text{vap}}/RT}",
     "ktex": "\\kP=Ae^{-\\kdHvap/R\\kT}",
     "condition": "the vapor pressure of a liquid, with T in kelvin",
     "anchor": "10.3-clausius"
    },
    {
     "id": "eq-clausius-clapeyron-log",
     "latex": "\\ln P=-\\frac{\\Delta H_{\\text{vap}}}{RT}+\\ln A",
     "ktex": "\\ln \\kP=-\\frac{\\kdHvap}{R\\kT}+\\ln A",
     "condition": "the logarithmic, linear form",
     "anchor": "10.3-clausius"
    }
   ]
  },
  {
   "id": "clausius-clapeyron-calculations",
   "kind": "skill",
   "section": "10.3",
   "name": "使用两点形式的克劳修斯–克拉珀龙方程",
   "statement": "已知两个温度下的蒸气压，可以由两点形式解出汽化焓；已知一组数据和汽化焓，可以求出另一温度下的蒸气压，或另一压强下的沸点。",
   "forms": [
    {
     "id": "eq-clausius-clapeyron-two-point",
     "latex": "\\ln\\left(\\frac{P_2}{P_1}\\right)=\\frac{\\Delta H_{\\text{vap}}}{R}\\left(\\frac{1}{T_1}-\\frac{1}{T_2}\\right)",
     "ktex": "\\ln\\left(\\frac{\\kPtwo}{\\kPone}\\right)=\\frac{\\kdHvap}{R}\\left(\\frac{1}{\\kTone}-\\frac{1}{\\kTtwo}\\right)",
     "condition": "two vapor pressure-temperature pairs of one liquid",
     "anchor": "10.3-clausius"
    }
   ]
  },
  {
   "id": "enthalpies-of-phase-change",
   "kind": "definition",
   "section": "10.3",
   "name": "相变焓",
   "symbol": "ΔH_vap",
   "type": "energy",
   "statement": "熔化、汽化和升华是吸热过程，凝固、凝结和凝华则放出数值相同、符号相反的热量。熔化只是部分克服分子间的吸引作用，而汽化则完全克服，所以 ΔH<sub>fus</sub> 小于 ΔH<sub>vap</sub>，并且由盖斯定律，ΔH<sub>sub</sub> 约等于二者之和。",
   "forms": [
    {
     "id": "eq-sublimation-sum",
     "latex": "\\Delta H_{\\text{sub}}=\\Delta H_{\\text{fus}}+\\Delta H_{\\text{vap}}",
     "ktex": "\\kdHsub=\\kdHfus+\\kdHvap",
     "condition": "sublimation modeled as melting followed by vaporization (Hess's law)",
     "anchor": "10.3-sublimation"
    }
   ]
  },
  {
   "id": "heating-curve",
   "kind": "idea",
   "section": "10.3",
   "name": "加热曲线与冷却曲线",
   "statement": "以恒定速率加热一种物质时，其温度在每一相内上升，如 q = mcΔT 所描述；在每次相变时温度保持不变，此时热量用于克服分子间的吸引作用。加热曲线上的平台就是它的相变。"
  },
  {
   "id": "heating-curve-calculations",
   "kind": "skill",
   "section": "10.3",
   "name": "由加热曲线计算热量",
   "statement": "物质经过若干相的变化所需的热量，是各步热量之和：相内每一段升温或降温用 q = mcΔT，其中 c 为该相的比热容；每一次相变用 q = nΔH。"
  },
  {
