              "tex": "\\mk{E}{\\kEcell} = \\mk{E0}{\\kEocell} - \\mk{c}{\\frac{(8.314\\ \\text{J/K mol})(298.15\\ \\text{K})}{\\kn\\,(96{,}485\\ \\text{C/mol})}}\\;\\mk{L}{\\text{ln}\\;\\kQrxn}",
              "uses": [
