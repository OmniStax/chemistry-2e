            "tex": "\\mk{E}{\\kEcell} = \\mk{E0}{\\kEocell} - \\mk{c}{\\;\\frac{R\\kT}{\\kn\\kFaraday}}\\;\\mk{L}{\\text{ln}\\;\\kQrxn}",
            "src": "17.4"
          },
          "steps": [
