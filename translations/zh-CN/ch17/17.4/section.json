              "tex": "\\mk{E}{\\kEcell} = \\mk{E0}{\\kEocell} - \\mk{c}{\\frac{0.02569\\ \\text{V}}{\\kn}}\\;\\mk{L}{(2.303\\;\\text{log}\\;\\kQrxn)}",
